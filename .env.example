# PostgreSQL (compose.yaml) — used from Fase 3A onward
POSTGRES_DB=datahub
POSTGRES_USER=datahub
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Backend
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/datahub
SPRING_DATASOURCE_USERNAME=datahub
SPRING_DATASOURCE_PASSWORD=change-me
# SPRING_PROFILES_ACTIVE=local

# Immutable raw artifact root (never point at a shared upload temp)
DATAHUB_RAW_STORAGE_ROOT=./data/raw-storage

# Upload limits
DATAHUB_IMPORTS_MAX_FILES=20
DATAHUB_IMPORTS_MAX_FILE_BYTES=33554432
DATAHUB_MAX_FILE_SIZE=32MB
DATAHUB_MAX_REQUEST_SIZE=64MB

# Security — keep false on controlled local networks.
# Production profile forces enabled=true and requires users.
DATAHUB_SECURITY_ENABLED=false
# DATAHUB_SECURITY_USERS=viewer:change-me:VIEWER,importer:change-me:IMPORTER|VIEWER,admin:change-me:ADMIN|IMPORTER|VIEWER

# CORS — empty = same-origin only. Dev Vite:
DATAHUB_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional absolute path to the private fixtures package (Fase 0/2)
# DATAHUB_FIXTURES_DIR=/absolute/path/to/qrp-fixtures
